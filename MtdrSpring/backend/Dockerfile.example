FROM eclipse-temurin:21-jre

RUN mkdir -p /opt/app

WORKDIR /opt/app

EXPOSE 8080

COPY target/MyTodoList-0.0.1-SNAPSHOT.jar MyTodoList.jar

# Example kept as a reference for the simple image packaging approach.
# The Oracle wallet is not copied into the image.
# Use a runtime secret volume in Kubernetes or a local bind mount when needed.
ENTRYPOINT ["java", "-jar", "MyTodoList.jar"]