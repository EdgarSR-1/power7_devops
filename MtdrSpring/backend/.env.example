# Copy this file to .env.local and replace placeholders with real values.
# Linux/macOS:
#   cp .env.example .env.local
#   set -a; source .env.local; set +a
# DO NOT commit .env.local or any wallet files to git. See .gitignore.

# Active Spring profile (keep 'oracle' if using Oracle ATP + wallet)
SPRING_PROFILES_ACTIVE=oracle

# JWT / App secret (required for token signing)
# - Must be kept secret and should be at least 32 characters.
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_SECRET

# ---------- Oracle (ATP) configuration ----------
# Use a TNS alias in the JDBC URL and set TNS_ADMIN separately.
# The driver will look for tnsnames.ora and wallet files under TNS_ADMIN.
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@REPLACE_TNS_ALIAS
SPRING_DATASOURCE_USERNAME=REPLACE_DB_USER
SPRING_DATASOURCE_PASSWORD=REPLACE_DB_PASSWORD
SPRING_DATASOURCE_DRIVER_CLASS_NAME=oracle.jdbc.OracleDriver
# Path inside the container where the wallet will be mounted at runtime
TNS_ADMIN=/mtdrworkshop/creds

# Backwards-compat mappings (optional; prefer SPRING_* names above)
db_user=${SPRING_DATASOURCE_USERNAME}
dbpassword=${SPRING_DATASOURCE_PASSWORD}
db_url=${SPRING_DATASOURCE_URL}
driver_class_name=${SPRING_DATASOURCE_DRIVER_CLASS_NAME}

# ---------- Telegram bot (optional) ----------
# If empty or TELEGRAM_ENABLED=false the bot will not auto-initialize.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_NAME=
# Feature flags (use 'false' to disable during local development)
TELEGRAM_ENABLED=false
TELEGRAM_BOT_AUTO_INIT=false

# ---------- DeepSeek / AI features (optional) ----------
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# ---------- UI / misc ----------
UI_USERNAME=admin
UI_PASSWORD=change_me

# Notes:
# - Keep secrets in a secure store for production (Kubernetes Secrets, OCI Vault, HashiCorp Vault, etc.).
# - Wallet files (tnsnames.ora, sqlnet.ora, cwallet.sso, ewallet.p12, keystore/truststore) must be
#   kept out of the repo and mounted at runtime to the path configured in TNS_ADMIN.
# - To enable Telegram locally: set TELEGRAM_ENABLED=true and put a valid TELEGRAM_BOT_TOKEN,
#   then restart the container.