# Copy this file to .env.local and replace placeholders with real values.
# Linux/macOS:
#   cp .env.example .env.local
#   set -a; source .env.local; set +a

# Profile
SPRING_PROFILES_ACTIVE=oracle

# JWT
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_CHARS_SECRET

# Oracle DB (required when SPRING_PROFILES_ACTIVE=oracle)
db_user=REPLACE_DB_USER
dbpassword=REPLACE_DB_PASSWORD
db_url=jdbc:oracle:thin:@REPLACE_DB_SERVICE?TNS_ADMIN=/mtdrworkshop/creds
driver_class_name=oracle.jdbc.OracleDriver

# Bot
TELEGRAM_BOT_TOKEN=REPLACE_TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_NAME=REPLACE_TELEGRAM_BOT_NAME
APP_BOT_MODE=telegram

# DeepSeek (optional if AI features are not used)
DEEPSEEK_API_KEY=REPLACE_DEEPSEEK_API_KEY
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions

# Optional UI credentials used by some deployment scripts
ui_username=REPLACE_UI_USERNAME
ui_password=REPLACE_UI_PASSWORD