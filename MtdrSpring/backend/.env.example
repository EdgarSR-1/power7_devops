# Copy this file to .env.local and fill it with your private values.

db_user=YOUR_DB_USER
dbpassword=YOUR_DB_PASSWORD
db_url=jdbc:oracle:thin:@YOUR_DB_SERVICE?TNS_ADMIN=/mtdrworkshop/creds
driver_class_name=oracle.jdbc.OracleDriver

ui_username=YOUR_UI_USERNAME
ui_password=YOUR_UI_PASSWORD

telegram.bot.token=YOUR_TELEGRAM_BOT_TOKEN
telegram.bot.name=YOUR_TELEGRAM_BOT_NAME

deepseek.api.key=YOUR_DEEPSEEK_API_KEY
deepseek.api.url=https://api.deepseek.com/v1/chat/completions